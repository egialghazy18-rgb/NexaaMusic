/* ═══════════════════════════════════════════════
   BERANDA — navy night + emas (hm-*)
   Dipakai hanya di halaman beranda: body.theme-home
   ═══════════════════════════════════════════════ */
body.theme-home { background: #0c1020; }
body.theme-home #aurora-bg { display: none; }
body.theme-home::before {
  content: "";
  position: fixed;
  inset: 0;
  z-index: 0;
  pointer-events: none;
  background:
    radial-gradient(120% 46% at 50% -8%, rgba(96, 116, 255, 0.16), transparent 62%),
    radial-gradient(80% 36% at 105% 102%, rgba(128, 76, 230, 0.12), transparent 64%);
}
/* sama persis, tapi lewat :has() supaya navy sudah aktif di paint pertama (tanpa kedip).
   Dipisah dari rule di atas agar browser lama tanpa :has() tetap jalan lewat class. */
body:has(.hm-page) { background: #0c1020; }
body:has(.hm-page) #aurora-bg { display: none; }
body:has(.hm-page)::before {
  content: "";
  position: fixed;
  inset: 0;
  z-index: 0;
  pointer-events: none;
  background:
    radial-gradient(120% 46% at 50% -8%, rgba(96, 116, 255, 0.16), transparent 62%),
    radial-gradient(80% 36% at 105% 102%, rgba(128, 76, 230, 0.12), transparent 64%);
}

.hm-page {
  --hm-title: #b4c0ff;
  --hm-text: #eef0f8;
  --hm-muted: #98a0b8;
  --hm-gold: #f0c453;
  --hm-gold-line: rgba(226, 181, 62, 0.7);
  --hm-btn: clamp(42px, 12.4vw, 54px);
  --hm-card-w: clamp(124px, 33vw, 164px);
  --hm-spring: cubic-bezier(0.2, 0.8, 0.2, 1);
}
.hm-page.page {
  padding-top: calc(14px + env(safe-area-inset-top));
  padding-left: 14px;
  padding-right: 14px;
}

/* satu momen masuk: tiap blok naik pelan berurutan */
.hm-rise {
  animation: hm-rise 0.6s var(--hm-spring) both;
  animation-delay: calc(var(--d, 0) * 70ms);
}
@keyframes hm-rise {
  from { opacity: 0; transform: translate3d(0, 14px, 0); }
  to   { opacity: 1; transform: translate3d(0, 0, 0); }
}

.hm-inset { margin-left: 12px; margin-right: 12px; }

/* ── header ── */
.hm-header { display: flex; align-items: center; justify-content: space-between; gap: 10px; }
.hm-avatar {
  flex: 0 0 auto;
  width: 40px; height: 40px;
  border-radius: 50%;
  overflow: hidden;
  background: #000;
  border: 1px solid rgba(255, 255, 255, 0.14);
  transition: transform 0.2s var(--hm-spring);
}
.hm-avatar img { width: 100%; height: 100%; object-fit: cover; }
.hm-avatar:active { transform: scale(0.92); }
.hm-actions { display: flex; align-items: center; gap: clamp(6px, 2.4vw, 12px); }
.hm-round {
  width: var(--hm-btn); height: var(--hm-btn);
  display: grid; place-items: center;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.13);
  color: #e9ebf5;
  transition: background 0.2s ease, transform 0.2s var(--hm-spring);
}
.hm-round:active { transform: scale(0.9); background: rgba(255, 255, 255, 0.22); }

.hm-greeting {
  margin: 22px 12px 16px;
  font-size: clamp(24px, 7vw, 30px);
  line-height: 1.15;
  font-weight: 700;
  letter-spacing: -0.015em;
  color: var(--hm-text);
  overflow-wrap: anywhere;
}

/* ── kartu profil ── */
.hm-profile {
  display: flex; align-items: center; gap: 10px;
  padding: 10px 12px 10px 8px;
  border-radius: 22px;
  border: 1.5px solid var(--hm-gold-line);
  background:
    linear-gradient(180deg, rgba(226, 181, 62, 0.07), rgba(226, 181, 62, 0.02)),
    rgba(14, 17, 30, 0.82);
  box-shadow: inset 0 1px 0 rgba(255, 225, 140, 0.12), 0 10px 26px rgba(0, 0, 0, 0.28);
  color: inherit;
  transition: transform 0.2s var(--hm-spring);
}
.hm-profile:active { transform: scale(0.985); }
.hm-emblem { flex: 0 0 auto; width: 76px; display: grid; place-items: center; }
.hm-profile-body { flex: 1 1 auto; min-width: 0; display: flex; flex-direction: column; gap: 7px; }
.hm-profile-top { display: flex; flex-wrap: wrap; align-items: center; gap: 6px 8px; min-width: 0; }
.hm-badge {
  display: inline-flex; align-items: center; gap: 5px;
  padding: 5px 9px;
  border-radius: 8px;
  background: rgba(226, 181, 62, 0.2);
  color: var(--hm-gold);
  font-size: 11px; font-weight: 800; letter-spacing: 0.07em;
  white-space: nowrap;
}
.hm-profile-id { display: inline-flex; align-items: center; gap: 5px; min-width: 0; flex: 1 1 auto; }
.hm-profile-name {
  min-width: 0;
  font-size: 16px; font-weight: 700; color: #fff;
  white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
}
.hm-profile-id svg { flex: 0 0 auto; }
.hm-profile-meta {
  display: flex; align-items: center; gap: 7px;
  font-size: 14px; color: #c4c8d8; white-space: nowrap;
}
.hm-profile-meta strong { color: var(--hm-gold); font-weight: 800; }
.hm-dot { width: 4px; height: 4px; border-radius: 50%; background: #6b7088; flex: 0 0 auto; }
.hm-profile-btn {
  flex: 0 0 auto;
  display: inline-flex; align-items: center; gap: 4px;
  padding: 11px 13px;
  border-radius: 14px;
  border: 1.5px solid var(--hm-gold-line);
  background: rgba(226, 181, 62, 0.1);
  color: var(--hm-gold);
  font-size: 14px; font-weight: 800;
}

/* ── chip pintasan ── */
.hm-chips {
  display: flex; gap: 8px;
  margin: 22px -14px 0;
  padding: 0 14px 2px;
  overflow-x: auto;
  scrollbar-width: none;
  -webkit-overflow-scrolling: touch;
}
.hm-chips::-webkit-scrollbar { display: none; }
.hm-chip {
  flex: 0 0 auto;
  display: inline-flex; align-items: center;
  height: 36px; padding: 0 17px;
  border-radius: 999px;
  background: rgba(255, 255, 255, 0.12);
  color: #d6d9e8;
  font-size: 15px; font-weight: 600;
  transition: background 0.2s ease, transform 0.18s var(--hm-spring);
}
.hm-chip:active { transform: scale(0.95); background: rgba(255, 255, 255, 0.2); }

/* ── section ── */
.hm-section { margin-top: 30px; }
.hm-section-head { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin: 0 2px 14px; }
.hm-title {
  font-size: 22px; line-height: 1.2; font-weight: 700; letter-spacing: -0.01em;
  color: var(--hm-title);
}
.hm-see-all {
  display: grid; place-items: center;
  width: 38px; height: 38px; margin: -6px -4px -6px 0;
  border-radius: 50%;
  color: var(--hm-title);
  transition: transform 0.25s var(--hm-spring), background 0.2s ease;
}
.hm-see-all:active { transform: translateX(3px) scale(0.92); background: rgba(255, 255, 255, 0.08); }

.hm-row {
  display: flex; gap: 18px;
  margin: 0 -14px;
  padding: 2px 14px 8px;
  overflow-x: auto;
  scroll-snap-type: x proximity;
  scroll-padding-left: 14px;
  scrollbar-width: none;
  -webkit-overflow-scrolling: touch;
}
.hm-row::-webkit-scrollbar { display: none; }

.hm-card {
  flex: 0 0 var(--hm-card-w);
  min-width: 0;
  display: flex; flex-direction: column;
  padding: 0; border: 0; background: none;
  color: inherit; text-align: left;
  scroll-snap-align: start;
  cursor: pointer;
  transition: transform 0.22s var(--hm-spring);
}
.hm-card:active { transform: scale(0.97); }
.hm-cover {
  position: relative; display: block;
  aspect-ratio: 1 / 1;
  border-radius: 14px;
  overflow: hidden;
  background: #1a1f33;
  box-shadow: 0 8px 20px rgba(0, 0, 0, 0.28);
}
.hm-cover img { display: block; width: 100%; height: 100%; object-fit: cover; }
.hm-mosaic { display: grid; grid-template-columns: 1fr 1fr; grid-template-rows: 1fr 1fr; }
.hm-card-title {
  display: block; margin-top: 10px;
  font-size: 16px; font-weight: 700; color: var(--hm-text);
  white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
}
.hm-card-sub {
  display: block; margin-top: 2px;
  font-size: 14px; color: var(--hm-muted);
  white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
}
.hm-play {
  position: absolute; right: 8px; bottom: 8px;
  width: 38px; height: 38px;
  display: grid; place-items: center;
  border-radius: 50%;
  background: rgba(10, 12, 24, 0.55);
  border: 1px solid rgba(255, 255, 255, 0.22);
  -webkit-backdrop-filter: blur(8px);
  backdrop-filter: blur(8px);
  color: #fff;
  transition: transform 0.25s var(--hm-spring), background 0.2s ease;
}
.hm-card:active .hm-play { transform: scale(0.9); background: rgba(10, 12, 24, 0.75); }

.hm-skel {
  background: linear-gradient(90deg, rgba(255,255,255,.05) 0%, rgba(255,255,255,.11) 50%, rgba(255,255,255,.05) 100%);
  background-size: 200% 100%;
  animation: hm-shimmer 1.4s linear infinite;
}
.hm-skel-line { display: block; height: 14px; border-radius: 999px; }
@keyframes hm-shimmer { from { background-position: 200% 0; } to { background-position: -200% 0; } }

/* ── shelf lama (Baru Diputar, Playlist Kamu, rekomendasi) ikut tema beranda ── */
.hm-page .shelf { margin: 30px 0 0; }
.hm-page .shelf-head { margin-bottom: 14px; }
.hm-page .h2 { font-size: 22px; font-weight: 700; letter-spacing: -0.01em; color: var(--hm-title); }
.hm-page .empty p { color: var(--hm-muted); }

@media (min-width: 700px) {
  .hm-page { --hm-card-w: 168px; }
  .hm-page.page { padding-left: 20px; padding-right: 20px; }
  .hm-row, .hm-chips { margin-left: -20px; margin-right: -20px; padding-left: 20px; padding-right: 20px; }
}

@media (prefers-reduced-motion: reduce) {
  .hm-rise, .hm-skel { animation: none; }
  .hm-card, .hm-round, .hm-chip, .hm-profile, .hm-avatar, .hm-see-all, .hm-play { transition: none; }
}
